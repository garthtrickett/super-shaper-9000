WEB_PRUNES=(
    "./node_modules"
    "./dist"
    "./.git"
    "./.vite"
    "./target"
    "./coverage"
    ".eslintcache"
    
    # --- LOCK FILES (Context Bloat) ---
    "Cargo.lock"
    "flake.lock"
    "bun.lockb"
    "bun.lock"
    ".env"
    "*.jks"
    "*.p12"

    # --- GENERATED WASM BINDINGS (Source is in Rust) ---
    "./src/lib/client/wasm/surfer_wasm_bg.wasm"
    "./src/lib/client/wasm/surfer_wasm.js"
    "./src/lib/client/wasm/surfer_wasm.d.ts"
    "./src/lib/client/wasm/surfer_wasm_bg.wasm.d.ts"
    "./src/lib/client/wasm/snippets"

    # --- LARGE REFERENCE DATA ---
    "current_response.json"
    "a.txt.tmp"

    "./playwright-report/*"
    ./test-results/*
    


    # Exclude all but one s3dx file 
    "./src/assets/fixtures/s3dx/FISH.s3dx"
    "./src/assets/fixtures/s3dx/TomoLike.s3dx"
    "./src/assets/fixtures/s3dx/rounded-pin-6-1.s3dx"
    "./src/assets/fixtures/s3dx/CI-Dumpster-Diver.s3dx"
    # "./src/assets/fixtures/s3dx/gh-60-winged-swallow.s3dx"
    "./src/assets/fixtures/s3dx/wildcat-fixed-winged-pin.s3dx"
    
    # Exclude all but one brd file
    "./src/assets/fixtures/brd/*"

    
    "*.png"
    "*.jpg"
    "*.brd" # You mentioned these break the LLM
)
